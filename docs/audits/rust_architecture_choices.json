    "performance_optimizations": {
      "graph_rendering": [
        {
          "technique": "Virtualization",
          "description": "Only render nodes visible in current viewport",
          "impact": "High",
          "complexity": "Medium",
          "sources": ["https://developer.mozilla.org/en-US/docs/Mozilla/Performance/Scrolling"]
        },
        {
          "technique": "WebGL/OpenGL (wgpu)",
          "description": "Hardware-accelerated rendering for thousands of nodes",
          "impact": "High",
          "complexity": "High",
          "sources": [
            "https://wgpu.rs",
            "https://github.com/gfx-rs/wgpu"
          ]
        },
        {
          "technique": "Levels of Detail (LOD)",
          "description": "Simplify rendering for distant nodes",
          "impact": "Medium",
          "complexity": "Medium"
        }
      ],
      "loading": [
        {
          "technique": "Lazy Loading",
          "description": "Load files on-demand",
          "impact": "High",
          "complexity": "Low"
        },
        {
          "technique": "Background Loading",
          "description": "Load files in background threads",
          "impact": "High",
          "complexity": "Medium"
        }
      ],
      "caching": [
        {
          "technique": "Multi-level Cache",
          "description": "L1: Memory, L2: Disk, L3: Persistent",
          "impact": "High",
          "complexity": "Low",
          "sources": ["https://docs.rs/lru"]
        },
        {
          "technique": "Query Cache",
          "description": "Cache Datalog query results",
          "impact": "Medium",
          "complexity": "Low"
        }
      ],
      "queries": [
        {
          "technique": "SQLite Indexes",
          "description": "B-tree indexes on frequent predicates",
          "impact": "High",
          "complexity": "Low"
        },
        {
          "technique": "Incremental Queries",
          "description": "Only recompute changed parts of graph",
          "impact": "High",
          "complexity": "High"
        }
      ],
      "parallelism": [
        {
          "technique": "rayon",
          "description": "Data parallelism for parsing, etc.",
          "impact": "Medium",
          "complexity": "Low",
          "sources": ["https://docs.rs/rayon"]
        }
      ]
    }
  },
