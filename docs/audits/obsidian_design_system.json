  "animations": {
    "durations": {
      "none": "0ms",
      "superfast": "70ms",
      "fast": "140ms",
      "moderate": "300ms",
      "slow": "560ms"
    },
    
    "easing": {
      "smooth": "cubic-bezier(0.45, 0.05, 0.55, 0.95)",
      "delay": "cubic-bezier(0.65, 0.05, 0.36, 1)",
      "jumpy": "cubic-bezier(0.68, -0.55, 0.27, 1.55)",
      "swing": "cubic-bezier(0, 0.55, 0.45, 1)",
      "spring": "cubic-bezier(0.36, 0.7, 0, 1)"
    },
    
    "transitions": {
      "hover": {
        "filter": "brightness(0.9)",
        "duration": "70ms",
        "easing": "cubic-bezier(0.45, 0.05, 0.55, 0.95)"
      },
      "button": {
        "background": "140ms",
        "border": "140ms",
        "color": "140ms"
      },
      "input": {
        "border": "140ms",
        "box_shadow": "140ms"
      },
      "focus": {
        "outline": "140ms",
        "box_shadow": "140ms"
      }
    },
    
    "drag_and_drop": {
      "ghost_background": "rgba(0, 0, 0, 0.85)",
      "ghost_text_color": "#fff",
      "item_background": "#1C1C1C",
      "item_shadow": "0 2px 8px [A VERIFIER]",
      "transition": "140ms"
    },
    
    "interactions": {
      "click": {
        "active_scale": "0.95",
        "transition": "70ms"
      },
      "hover": {
        "opacity": "0.85 to 1",
        "transition": "70ms"
      },
      "focus_ring": {
        "outline": "2px solid #0df",
        "outline_offset": "2px",
        "transition": "140ms"
      }
    }
  },
  
  "notes": [
    "Obsidian utilise un système de variables CSS avec des valeurs light-dark pour gérer les thèmes clair/sombre",
    "Les couleurs du thème sombre sont définies dans la classe .theme-dark",
    "La typographie par défaut utilise la police système, mais JetBrains Mono peut être configurée pour le code",
    "Les panneaux latéraux ont une largeur par défaut de 140px mais peuvent être redimensionnés",
    "Les animations utilisent des easing functions personnalisées pour une expérience fluide",
    "Certaines valeurs comme les largeurs maximales des sidebars nécessitent une vérification supplémentaire",
    "Les couleurs de syntaxe suivent un schéma cohérent avec les couleurs de base du thème"
  ]
}
